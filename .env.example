# Neural Protocol Suite Agent Kit environment overrides.
#
# Values in this file are loaded by bin/agent-kit when copied to .env.
# Exported environment variables take precedence.

# NPS_STATE_HOME="$HOME/.nps-agent-kit"
# NPS_AGENTS_HOME="$NPS_STATE_HOME/agents"
# NPS_WORKTREES_HOME="$NPS_STATE_HOME/worktrees"
# NPS_LOGS_HOME="$NPS_STATE_HOME/logs"

# Runtime executable. Defaults to scripts/runtime/mock-worker.sh.
# NPS_AGENT_RUNTIME_CMD="/absolute/path/to/runtime"
